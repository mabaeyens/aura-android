<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+, which is every device since minSdk is 26). Ported from the iOS AppIcon
  (aura-apps, icon-1024.png). The iOS art is full-bleed, so it becomes the *background* layer and fills the
  whole 108dp canvas: every launcher mask (your Pixel's squircle, a circle, a rounded square) then shows sky
  at the edges with no seam. The foreground is transparent, so the white "A" never shifts under the adaptive
  parallax and never gets clipped by a mask. Android note: unlike an iOS icon (one flat square), an adaptive
  icon is two stacked layers the launcher masks and animates — hence the split.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
