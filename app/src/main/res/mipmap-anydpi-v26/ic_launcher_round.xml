<?xml version="1.0" encoding="utf-8"?>
<!--
  The round-mask variant (some launchers request android:roundIcon explicitly). Identical layers to
  ic_launcher.xml; the launcher applies the round mask itself. Kept as its own file so the manifest's
  android:roundIcon has a target.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_bg" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
