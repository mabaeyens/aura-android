    <!-- About screen (Acerca de) -->
    <string name="about_title">About</string>
    <string name="about_app_name">Aura</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_blurb">Aura is a weather app for Android. It takes your nearest location and shows you the AEMET forecast in full colour: in the app itself and in the home screen widget. It updates on its own as the data changes.\n\nFrom the Latin aura: a breeze, air in motion, and also the halo of light around something.\n\nThe data comes from publicly accessible open data repositories. Everything happens on your device: no account and no servers of my own; it only connects to those sources to fetch the data.\n\nAura is an independent app. It is not affiliated with, and does not represent, AEMET, MITECO, or any government entity.</string>
    <string name="about_dedication_header">Dedication</string>
    <string name="about_dedication_father">To my father, who taught me to look up at the sky and the stars, and introduced me to the wonderful world of technology that I enjoy so much today.</string>
    <string name="about_dedication_mother">To my mother, who revealed to me other worlds that could not be seen with the eyes, through books, in which I find great joy.</string>
    <string name="about_credits_header">Credits</string>
    <string name="about_credit_aemet">Forecast, alerts, radar, and maximum UV (OpenData)</string>
    <string name="about_credit_miteco">Air quality index (ICA · CC-BY 4.0)</string>
    <string name="about_credit_copernicus">Hourly UV index, via Open-Meteo (CC-BY 4.0)</string>
    <string name="about_credit_rtve">El Tiempo, the daily report</string>
    <string name="about_credit_meteored">News and outreach (tiempo.com)</string>
    <string name="about_credit_aemetblog">Outreach from its meteorologists</string>
    <string name="about_credit_meteocons">Weather icons, by Bas Milius (MIT licence)</string>
    <string name="about_github">Code on GitHub</string>
    <string name="about_tagline">No account · no servers · public sources only</string>

