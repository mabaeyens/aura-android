    <!-- About screen (Acerca de) -->
    <string name="about_title">Acerca de</string>
    <string name="about_app_name">Aura</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_blurb">Aura es una app del tiempo para Android. Toma tu ubicación más cercana y te muestra la previsión de AEMET a todo color: en la propia app y en el widget de la pantalla de inicio. Se actualiza sola a medida que cambian los datos.\n\nDel latín aura: brisa, aire en movimiento, y también el halo de luz que rodea algo.\n\nLos datos vienen de repositorios de datos abiertos de acceso público. Todo ocurre en tu dispositivo: sin cuenta y sin servidores propios; solo se conecta a esas fuentes para traer los datos.\n\nAura es una app independiente. No está afiliada a AEMET, MITECO ni a ninguna entidad gubernamental, ni las representa.</string>
    <string name="about_dedication_header">Dedicatoria</string>
    <string name="about_dedication_father">A mi padre, que me enseñó a mirar al cielo y a las estrellas, y me introdujo en el fabuloso mundo de la tecnología que tanto disfruto hoy.</string>
    <string name="about_dedication_mother">A mi madre, que me descubrió otros mundos que no se podían ver con los ojos, a través de los libros y en los que encuentro gran dicha.</string>
    <string name="about_credits_header">Créditos</string>
    <string name="about_credit_aemet">Previsión, avisos, radar y UV máximo (OpenData)</string>
    <string name="about_credit_miteco">Índice de calidad del aire (ICA · CC-BY 4.0)</string>
    <string name="about_credit_copernicus">Índice UV por hora, vía Open-Meteo (CC-BY 4.0)</string>
    <string name="about_credit_rtve">El Tiempo, el parte diario</string>
    <string name="about_credit_meteored">Noticias y divulgación (tiempo.com)</string>
    <string name="about_credit_aemetblog">Divulgación de sus meteorólogos</string>
    <string name="about_credit_meteocons">Iconos del tiempo, de Bas Milius (licencia MIT)</string>
    <string name="about_github">Código en GitHub</string>
    <string name="about_tagline">Sin cuenta · sin servidores · solo fuentes públicas</string>

