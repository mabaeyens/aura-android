<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Network access for every data source (AEMET OpenData, MITECO air quality, Open-Meteo UV). INTERNET is a
      normal, install-time permission (no runtime prompt); without it okhttp fails at DNS with a SecurityException.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Coarse location only: enough to key the forecast to a municipality and compute sun times, and it lets
      Aura use the AOSP network/fused providers, which honour a coarse grant. FINE (GPS) is deliberately not
      requested unless a coarse fix proves too imprecise (see specs/location.md). No Google Play Services.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aura">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The Home Screen widget (Jetpack Glance). The receiver is the AppWidgetProvider the launcher talks
          to; Glance's base class forwards its broadcasts to AuraGlanceWidget. exported=true is required so the
          launcher (a different process) can bind it. The provider meta-data points at the sizing/preview xml.
        -->
        <receiver
            android:name=".widget.AuraWidgetReceiver"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aura_widget_info" />
        </receiver>
    </application>

</manifest>
