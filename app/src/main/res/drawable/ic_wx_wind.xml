<!--
    Meteocons "wind" gust glyph (Bas Milius, MIT), hand-ported from production/fill/all/wind.svg.
    The source SVG packs its arc flags ("a5 5 0 113.61 8.46") in a form svg2vectordrawable rejects,
    and carries an <animate> loop that has no vector-drawable equivalent, so the two gust strokes are
    transcribed here with the arc flags expanded (large-arc + sweep spelled out) and the animation
    dropped. Grey gradient and 3px round-capped stroke match the original.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M43.64 20a5 5 0 1 1 3.61 8.46h-35.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27.56"
                android:startY="17.64"
                android:endX="38.27"
                android:endY="36.19">
                <item android:color="#FFD4D7DD" android:offset="0"/>
                <item android:color="#FFD4D7DD" android:offset="0.45"/>
                <item android:color="#FFBEC1C6" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M29.14 44a5 5 0 1 0 3.61 -8.46h-21">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="19.96"
                android:startY="29.03"
                android:endX="31.37"
                android:endY="48.8">
                <item android:color="#FFD4D7DD" android:offset="0"/>
                <item android:color="#FFD4D7DD" android:offset="0.45"/>
                <item android:color="#FFBEC1C6" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
